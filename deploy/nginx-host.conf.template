# Generated by install.sh — reverse proxy for Wedding Photo Uploader.
# Placeholders: __SERVER_NAME__ __BASE_PATH__ __APP_PORT__ __CLIENT_MAX_BODY__

upstream photo_upload_app {
    server 127.0.0.1:__APP_PORT__;
}

server {
    listen 80;
    server_name __SERVER_NAME__;

    client_max_body_size __CLIENT_MAX_BODY__;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location = __BASE_PATH__ {
        return 308 __BASE_PATH__/;
    }

    location __BASE_PATH__/ {
        proxy_pass http://photo_upload_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
