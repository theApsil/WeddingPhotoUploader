# Generated by install.sh — HTTPS reverse proxy for Wedding Photo Uploader.
# Placeholders: __SERVER_NAME__ __BASE_PATH__ __APP_PORT__ __CLIENT_MAX_BODY__

upstream photo_upload_app {
    server 127.0.0.1:__APP_PORT__;
}

server {
    listen 80;
    server_name __SERVER_NAME__;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name __SERVER_NAME__;

    ssl_certificate     /etc/letsencrypt/live/__SERVER_NAME__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__SERVER_NAME__/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    client_max_body_size __CLIENT_MAX_BODY__;

    location = __BASE_PATH__ {
        return 308 __BASE_PATH__/;
    }

    location __BASE_PATH__/ {
        proxy_pass http://photo_upload_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
    }
}
