# Локальный диск (по умолчанию) или Yandex Object Storage
STORAGE_BACKEND=local

# --- local ---
STORAGE_DIR=./data
DATABASE_PATH=./data/photos.db

# --- yandex (нужны только при STORAGE_BACKEND=yandex) ---
YANDEX_ACCESS_KEY_ID=
YANDEX_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
# Optional custom bucket domain (CNAME). Empty = <bucket>.storage.yandexcloud.net
STORAGE_DOMAIN=
# false = private bucket + signed GET for gallery; true = public objects
PUBLIC_READ=false
# true = API issues mock signatures without real cloud (dev only)
S3_MOCK=false
PRESIGN_EXPIRES_SECONDS=3600

# Domains / CORS (no scheme, no trailing slash for SITE_DOMAIN)
SITE_DOMAIN=photos.example.com
# Allowed CORS origin is derived as https://${SITE_DOMAIN}
# For local without a domain:
# CORS_ORIGINS=http://localhost:8080
CORS_ORIGINS=

# App limits
MAX_FILE_SIZE_MB=15
# Videos (mp4/webm/mov/m4v) use their own, larger limit.
MAX_VIDEO_SIZE_MB=200
# 0 = no per-request file count limit (photos+videos).
MAX_FILES_PER_REQUEST=0
RATE_LIMIT_PER_MINUTE=20

# Gallery thumbnails: long edge of generated JPEG preview (px).
THUMBNAIL_SIZE=400

# Admin panel (/admin.html). Empty = admin disabled.
# Set a strong password, e.g. openssl rand -hex 16
ADMIN_PASSWORD=

# Subpath behind reverse-proxy (empty = site root). Example: /wedding
BASE_PATH=
# Optional absolute path to frontend/ (default: ../frontend next to backend/)
FRONTEND_DIR=

# Let's Encrypt (used by certbot service in docker compose)
LETSENCRYPT_EMAIL=admin@example.com
