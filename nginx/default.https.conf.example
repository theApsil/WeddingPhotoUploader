# Copy over default.conf after certbot succeeds, replace SITE_DOMAIN.

upstream photo_api {
    server api:8000;
}

server {
    listen 80;
    server_name SITE_DOMAIN;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name SITE_DOMAIN;

    ssl_certificate     /etc/nginx/certs/live/SITE_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/live/SITE_DOMAIN/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # Browser never uploads file bodies to nginx — only JSON to API.
    client_max_body_size 20m;

    location /api/ {
        proxy_pass http://photo_api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
    }
}
